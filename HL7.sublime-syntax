%YAML 1.2
---
name: HL7 v2.x
file_extensions:
  - hl7
scope: source.hl7

# Ctrl+Alt+Shift+P to test this

variables:
  msh: '(MSH)(\|)(\^\~\\\&|\S{4})' # group 1 = "MSH", group 2 = "|", group 3 = "^~\&" or whatever 4 chars were chosen
  segment_name: '[A-Z][A-Z0-9]{2}'
  standard_escapes: '\\[EFRST]\\'
  hex_data: '\\X[0-9A-Fa-f]+\\'
  datetime: '\d{8}(?:\d{2,6})?\b'

contexts:
  main:
    - match: '^{{msh}}'
      captures:
        1: entity.name.tag.segment.hl7
        2: punctuation.separator.field.hl7
        3: constant.character.encoding.hl7
      push: segment_body

    - match: '^({{segment_name}})'
      captures:
        1: entity.name.tag.segment.hl7
      push: segment_body

  # only standard separator will be supported for color highlighting in segment bodies. don't know if it is possible to dynamically format them
  segment_body:
    # end of line, used to proceed with the recognition of the next segment
    - match: '$'
      pop: true

    - match: '\|'
      scope: punctuation.separator.field.hl7

    - match: '~'
      scope: punctuation.separator.repetition.hl7

    - match: '\^'
      scope: punctuation.separator.component.hl7

    - match: '&'
      scope: punctuation.separator.subcomponent.hl7

    # standard escapes: \E\, \F\, \R\, \S\, \T\
    - match: '({{standard_escapes}})'
      scope: constant.character.escape.hl7

    # hex data: \Xhhhh\
    - match: '({{hex_data}})'
      scope: constant.character.escape.hl7

    # other escapes which i'm not aware of
    - match: '\\'
      scope: constant.character.escape.hl7

    # datetime: 8-14 digit sequences (YYYYMMDDHHMMSS pattern)
    - match: '({{datetime}})'
      scope: constant.numeric.hl7

    # everything else
    - match: '[^|~^&\\]+'
      scope: string.unquoted.hl7
